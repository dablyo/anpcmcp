# anp-mcp 单控制器模式模板
# 复制为 .env 并填写（.env 已被 .gitignore 排除，不会入库）。
# 也可不经 .env，直接在 MCP 客户端配置的 env 字段中注入同名变量。
ANP_BASE_URL=https://10.1.203.3:8443
ANP_USERNAME=admin
# 二选一：明文密码（运行时自动 MD5 后调用认证接口），或直接给 MD5（优先级更高）
ANP_PASSWORD=changeme
#ANP_PASSWORD_MD5=21232f297a57a5a743894a0e4a801fc3
# 控制器多为自签证书，默认跳过校验；生产环境建议 true + 信任证书
ANP_VERIFY_SSL=false
# 单请求超时（秒）
ANP_TIMEOUT=30
# 日志级别（日志永不输出凭据/token）
ANP_LOG_LEVEL=WARNING
